<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AG Electric Works | Professional Electrical Contractors</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
         :root {
            --blue: #1a3fcc;
            --blue-bright: #2b52e8;
            --blue-glow: #3a6aff;
            --blue-light: #4d7fff;
            --blue-pale: #8aabff;
            --dark: #060a14;
            --dark-2: #0b1020;
            --dark-3: #0f1830;
            --dark-4: #131e3a;
            --dark-5: #1a2545;
            --mid: #1e2d55;
            --text: #c8d6f0;
            --text-dim: #7a92c0;
            --white: #e8eeff;
            --accent: #00cfff;
            --gold: #f0b400;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html {
            scroll-behavior: smooth;
        }
        
        body {
            background: var(--dark);
            color: var(--text);
            font-family: 'Rajdhani', sans-serif;
            font-size: 17px;
            overflow-x: hidden;
        }
        /* ===== NOISE OVERLAY ===== */
        
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 1000;
            opacity: 0.5;
        }
        /* ===== HEADER ===== */
        
        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 900;
            background: rgba(6, 10, 20, 0.92);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(42, 82, 232, 0.3);
            padding: 0 3rem;
            height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .header-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .logo-img {
            height: 52px;
            width: auto;
            filter: drop-shadow(0 0 10px rgba(42, 82, 232, 0.6));
        }
        
        .brand-name {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.6rem;
            letter-spacing: 3px;
            color: var(--white);
            line-height: 1;
        }
        
        .brand-sub {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.6rem;
            letter-spacing: 4px;
            color: var(--blue-pale);
            text-transform: uppercase;
        }
        
        nav {
            display: flex;
            align-items: center;
            gap: 2.5rem;
        }
        
        nav a {
            color: var(--text-dim);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: color 0.3s;
            position: relative;
        }
        
        nav a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--blue-glow);
            transition: width 0.3s;
            box-shadow: 0 0 8px var(--blue-glow);
        }
        
        nav a:hover {
            color: var(--white);
        }
        
        nav a:hover::after {
            width: 100%;
        }
        
        .nav-cta {
            background: var(--blue);
            color: var(--white) !important;
            padding: 0.5rem 1.4rem;
            border: 1px solid var(--blue-bright);
            clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
            transition: background 0.3s !important;
        }
        
        .nav-cta:hover {
            background: var(--blue-bright) !important;
        }
        
        .nav-cta::after {
            display: none !important;
        }
        /* ===== HERO ===== */
        
        #hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding: 8rem 3rem 4rem;
        }
        
        .hero-bg {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 70% at 70% 50%, rgba(26, 63, 204, 0.18) 0%, transparent 70%), radial-gradient(ellipse 40% 60% at 20% 80%, rgba(0, 207, 255, 0.06) 0%, transparent 60%), linear-gradient(180deg, var(--dark) 0%, var(--dark-2) 100%);
        }
        /* Electric grid lines */
        
        .hero-grid {
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(42, 82, 232, 0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(42, 82, 232, 0.07) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse 80% 80% at 60% 50%, black 30%, transparent 80%);
        }
        /* Lightning bolt decorations */
        
        .bolt-deco {
            position: absolute;
            opacity: 0.06;
            color: var(--blue-bright);
        }
        
        .bolt-1 {
            top: 10%;
            right: 5%;
            font-size: 300px;
            transform: rotate(-15deg);
            animation: pulse-bolt 4s ease-in-out infinite;
        }
        
        .bolt-2 {
            bottom: 5%;
            left: 2%;
            font-size: 200px;
            transform: rotate(20deg);
            animation: pulse-bolt 6s ease-in-out infinite 2s;
        }
        
        @keyframes pulse-bolt {
            0%,
            100% {
                opacity: 0.04;
            }
            50% {
                opacity: 0.1;
            }
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 680px;
        }
        
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(42, 82, 232, 0.15);
            border: 1px solid rgba(42, 82, 232, 0.4);
            padding: 0.35rem 1rem;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.75rem;
            letter-spacing: 3px;
            color: var(--blue-pale);
            margin-bottom: 2rem;
            clip-path: polygon(6px 0%, 100% 0%, calc(100% - 6px) 100%, 0% 100%);
        }
        
        .hero-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--accent);
            animation: blink 2s ease-in-out infinite;
        }
        
        @keyframes blink {
            0%,
            100% {
                opacity: 1
            }
            50% {
                opacity: 0.2
            }
        }
        
        .hero-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(3.5rem, 8vw, 6.5rem);
            line-height: 0.95;
            letter-spacing: 2px;
            color: var(--white);
            margin-bottom: 1.5rem;
        }
        
        .hero-title .highlight {
            color: transparent;
            -webkit-text-stroke: 2px var(--blue-bright);
            text-shadow: 0 0 40px rgba(42, 82, 232, 0.5);
        }
        
        .hero-desc {
            font-size: 1.1rem;
            line-height: 1.7;
            color: var(--text-dim);
            max-width: 520px;
            margin-bottom: 2.5rem;
            font-weight: 500;
        }
        
        .hero-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        
        .btn-primary {
            background: var(--blue);
            color: var(--white);
            text-decoration: none;
            padding: 0.9rem 2.5rem;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
            transition: all 0.3s;
            border: 1px solid var(--blue-bright);
            box-shadow: 0 0 20px rgba(42, 82, 232, 0.3);
        }
        
        .btn-primary:hover {
            background: var(--blue-bright);
            box-shadow: 0 0 35px rgba(42, 82, 232, 0.6);
            transform: translateY(-2px);
        }
        
        .btn-outline {
            background: transparent;
            color: var(--text);
            text-decoration: none;
            padding: 0.9rem 2.5rem;
            font-family: 'Rajdhani', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            border: 1px solid rgba(42, 82, 232, 0.5);
            clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
            transition: all 0.3s;
        }
        
        .btn-outline:hover {
            border-color: var(--blue-bright);
            color: var(--white);
            box-shadow: 0 0 20px rgba(42, 82, 232, 0.2);
        }
        /* Stats row */
        
        .hero-stats {
            position: absolute;
            right: 3rem;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 2rem;
            z-index: 2;
        }
        
        .stat-item {
            text-align: right;
            border-right: 3px solid var(--blue);
            padding-right: 1.5rem;
            position: relative;
        }
        
        .stat-item::before {
            content: '';
            position: absolute;
            right: -3px;
            top: 0;
            width: 3px;
            height: 100%;
            background: var(--blue-glow);
            box-shadow: 0 0 12px var(--blue-glow);
            animation: flicker 3s ease-in-out infinite;
        }
        
        @keyframes flicker {
            0%,
            100% {
                opacity: 1;
                box-shadow: 0 0 12px var(--blue-glow)
            }
            50% {
                opacity: 0.6;
                box-shadow: 0 0 6px var(--blue-glow)
            }
        }
        
        .stat-num {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 3rem;
            color: var(--blue-light);
            line-height: 1;
            text-shadow: 0 0 20px rgba(42, 82, 232, 0.5);
        }
        
        .stat-label {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 2px;
            color: var(--text-dim);
            text-transform: uppercase;
        }
        /* ===== SECTIONS COMMON ===== */
        
        section {
            padding: 6rem 3rem;
        }
        
        .section-label {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 4px;
            color: var(--blue-pale);
            text-transform: uppercase;
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }
        
        .section-label::before {
            content: '';
            width: 30px;
            height: 1px;
            background: var(--blue-bright);
            box-shadow: 0 0 8px var(--blue-bright);
        }
        
        .section-title {
            font-family: 'Bebas Neue', sans-serif;
            font-size: clamp(2.5rem, 5vw, 4rem);
            color: var(--white);
            letter-spacing: 2px;
            line-height: 1;
            margin-bottom: 1.5rem;
        }
        /* ===== ABOUT / STORY ===== */
        
        #about {
            background: var(--dark-2);
            position: relative;
            overflow: hidden;
        }
        
        #about::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--blue), transparent);
        }
        
        .about-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .about-text p {
            color: var(--text-dim);
            line-height: 1.9;
            margin-bottom: 1.2rem;
            font-size: 1.05rem;
            font-weight: 500;
        }
        
        .about-text p strong {
            color: var(--blue-pale);
            font-weight: 700;
        }
        
        .license-badges {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            margin-top: 2rem;
        }
        
        .badge-row {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            background: rgba(42, 82, 232, 0.08);
            border: 1px solid rgba(42, 82, 232, 0.2);
            padding: 0.6rem 1rem;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.78rem;
            letter-spacing: 1px;
            color: var(--text-dim);
            clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
        }
        
        .badge-row span:first-child {
            color: var(--blue-pale);
            font-weight: 700;
            min-width: 120px;
        }
        
        .about-visual {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .about-logo-wrap {
            width: 280px;
            height: 280px;
            border: 1px solid rgba(42, 82, 232, 0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            background: rgba(42, 82, 232, 0.05);
        }
        
        .about-logo-wrap::before,
        .about-logo-wrap::after {
            content: '';
            position: absolute;
            inset: -15px;
            border-radius: 50%;
            border: 1px solid rgba(42, 82, 232, 0.15);
        }
        
        .about-logo-wrap::after {
            inset: -30px;
            border-color: rgba(42, 82, 232, 0.08);
        }
        
        .about-logo-wrap img {
            width: 180px;
            filter: drop-shadow(0 0 25px rgba(42, 82, 232, 0.7));
            animation: float 4s ease-in-out infinite;
        }
        
        @keyframes float {
            0%,
            100% {
                transform: translateY(0)
            }
            50% {
                transform: translateY(-10px)
            }
        }
        /* ===== FEATURES ===== */
        
        #features {
            background: var(--dark);
            position: relative;
        }
        
        .features-header {
            max-width: 1200px;
            margin: 0 auto 3.5rem;
        }
        
        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5px;
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(42, 82, 232, 0.15);
        }
        
        .feature-card {
            background: var(--dark-3);
            padding: 2.5rem 2rem;
            position: relative;
            overflow: hidden;
            transition: all 0.4s;
            cursor: default;
        }
        
        .feature-card::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--blue);
            transform: scaleX(0);
            transition: transform 0.4s;
            box-shadow: 0 0 15px var(--blue-glow);
        }
        
        .feature-card:hover::before {
            transform: scaleX(1);
        }
        
        .feature-card:hover {
            background: var(--dark-4);
            transform: translateY(-4px);
        }
        
        .feature-icon {
            font-size: 2.5rem;
            margin-bottom: 1.2rem;
            display: block;
        }
        
        .feature-card h3 {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.6rem;
            letter-spacing: 2px;
            color: var(--white);
            margin-bottom: 0.8rem;
        }
        
        .feature-card p {
            color: var(--text-dim);
            font-size: 0.95rem;
            line-height: 1.7;
            font-weight: 500;
        }
        /* ===== BRANDS CAROUSEL ===== */
        
        #brands {
            background: var(--dark-2);
            padding: 4rem 0;
            overflow: hidden;
            position: relative;
        }
        
        #brands::before,
        #brands::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 150px;
            z-index: 2;
        }
        
        #brands::before {
            left: 0;
            background: linear-gradient(90deg, var(--dark-2), transparent);
        }
        
        #brands::after {
            right: 0;
            background: linear-gradient(-90deg, var(--dark-2), transparent);
        }
        
        .brands-label {
            text-align: center;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 4px;
            color: var(--blue-pale);
            text-transform: uppercase;
            margin-bottom: 2.5rem;
        }
        
        .carousel-track {
            display: flex;
            gap: 3rem;
            animation: scroll-left 20s linear infinite;
            width: max-content;
        }
        
        .carousel-track:hover {
            animation-play-state: paused;
        }
        
        @keyframes scroll-left {
            from {
                transform: translateX(0);
            }
            to {
                transform: translateX(-50%);
            }
        }
        
        .brand-logo-item {
            background: var(--dark-3);
            border: 1px solid rgba(42, 82, 232, 0.2);
            padding: 1rem 2.5rem;
            min-width: 160px;
            display: flex;
            align-items: center;
            justify-content: center;
            clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
            transition: border-color 0.3s;
        }
        
        .brand-logo-item:hover {
            border-color: rgba(42, 82, 232, 0.6);
        }
        
        .brand-logo-item span {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.3rem;
            letter-spacing: 3px;
            color: var(--text-dim);
            transition: color 0.3s;
        }
        
        .brand-logo-item:hover span {
            color: var(--blue-light);
        }
        /* ===== PROJECTS CAROUSEL ===== */
        
        #projects {
            background: var(--dark);
            padding: 4rem 0;
            overflow: hidden;
            position: relative;
        }
        
        #projects::before,
        #projects::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 180px;
            z-index: 2;
        }
        
        #projects::before {
            left: 0;
            background: linear-gradient(90deg, var(--dark), transparent);
        }
        
        #projects::after {
            right: 0;
            background: linear-gradient(-90deg, var(--dark), transparent);
        }
        
        #projects .section-top {
            text-align: center;
            margin-bottom: 2.5rem;
            padding: 0 3rem;
        }
        
        .projects-label {
            text-align: center;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 4px;
            color: var(--accent);
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }
        /* Scroll RIGHT (opposite direction from brands) */
        
        .projects-track {
            display: flex;
            gap: 1.5rem;
            animation: scroll-right 28s linear infinite;
            width: max-content;
        }
        
        .projects-track:hover {
            animation-play-state: paused;
        }
        
        @keyframes scroll-right {
            from {
                transform: translateX(-50%);
            }
            to {
                transform: translateX(0);
            }
        }
        
        .project-card {
            background: var(--dark-3);
            border: 1px solid rgba(42, 82, 232, 0.2);
            width: 280px;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
            clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
            transition: border-color 0.3s, transform 0.3s;
            cursor: default;
        }
        
        .project-card:hover {
            border-color: rgba(42, 82, 232, 0.7);
            transform: translateY(-6px);
        }
        
        .project-card-top {
            height: 130px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.2rem;
            position: relative;
            background: var(--dark-4);
            border-bottom: 1px solid rgba(42, 82, 232, 0.15);
        }
        
        .project-card-top .card-shimmer {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(42, 82, 232, 0.04) 25%, rgba(0, 207, 255, 0.10) 50%, rgba(42, 82, 232, 0.04) 75%);
            background-size: 200% 200%;
            animation: shimmer 4s ease-in-out infinite;
        }
        
        .project-tag {
            position: absolute;
            top: 0.6rem;
            right: 0.6rem;
            background: rgba(0, 207, 255, 0.12);
            border: 1px solid rgba(0, 207, 255, 0.3);
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.6rem;
            letter-spacing: 2px;
            color: var(--accent);
            padding: 0.2rem 0.5rem;
            text-transform: uppercase;
        }
        
        .project-card-body {
            padding: 1.2rem;
        }
        
        .project-card-body h4 {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.35rem;
            letter-spacing: 2px;
            color: var(--white);
            margin-bottom: 0.4rem;
            line-height: 1.1;
        }
        
        .project-card-body p {
            font-size: 0.85rem;
            color: var(--text-dim);
            line-height: 1.6;
            font-weight: 500;
        }
        
        .project-card-footer {
            padding: 0.7rem 1.2rem;
            border-top: 1px solid rgba(42, 82, 232, 0.12);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .project-location {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.65rem;
            letter-spacing: 1px;
            color: var(--text-dim);
        }
        
        .project-status {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #00e676;
            box-shadow: 0 0 8px #00e676;
            animation: blink 2s ease-in-out infinite;
        }
        /* ===== GALLERY ===== */
        
        #gallery {
            background: var(--dark-3);
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        #gallery::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--blue), transparent);
        }
        
        .gallery-header {
            max-width: 600px;
            margin: 0 auto 3rem;
        }
        
        .gallery-header p {
            color: var(--text-dim);
            font-size: 1rem;
            font-weight: 500;
            margin-bottom: 2rem;
        }
        
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 4px;
            max-width: 1000px;
            margin: 0 auto 3rem;
        }
        
        .gallery-thumb {
            aspect-ratio: 4/3;
            background: var(--dark-4);
